<Project>

    <!-- Shared MSBuild defaults for all Voluta packages.
         The nearest Directory.Build.props for every project under src/. -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>

        <!-- Warnings as errors — clean build = rules pass. -->
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

        <!-- XML docs required on public API, enforced via CS1591. -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <NoWarn>$(NoWarn);CS1591</NoWarn>

        <!-- OSS metadata — applied to every produced package. -->
        <Version>0.4.0</Version>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <Authors>Voluta contributors</Authors>
        <PackageProjectUrl>https://github.com/dot-stbl/voluta</PackageProjectUrl>
        <RepositoryUrl>https://github.com/dot-stbl/voluta</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>agents;stateful-graphs;workflows;checkpointing;dotnet</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <Copyright>Copyright (c) Voluta contributors</Copyright>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>

        <!-- Package icons: i5 = core, i3 = rare/specialized, i8 = ordinary (default). -->
        <VolutaPackageIconPath>$(MSBuildThisFileDirectory)assets\icon-i8.png</VolutaPackageIconPath>
        <VolutaPackageIconPath Condition="'$(MSBuildProjectName)' == 'Voluta'
                                          or '$(MSBuildProjectName)' == 'Voluta.Abstractions'
                                          or '$(MSBuildProjectName)' == 'Voluta.DependencyInjection'">$(MSBuildThisFileDirectory)assets\icon-i5.png</VolutaPackageIconPath>
        <VolutaPackageIconPath Condition="'$(MSBuildProjectName)' == 'Voluta.Checkpoints.Redis'
                                          or '$(MSBuildProjectName)' == 'Voluta.Generators'
                                          or '$(MSBuildProjectName)' == 'Voluta.Templates'
                                          or '$(MSBuildProjectName)' == 'Voluta.OpenTelemetry'">$(MSBuildThisFileDirectory)assets\icon-i3.png</VolutaPackageIconPath>
        <PackageIcon>$([System.IO.Path]::GetFileName('$(VolutaPackageIconPath)'))</PackageIcon>

        <!-- Globally suppressed warnings (with documented reason) -->
        <!-- NU1903 — Testcontainers.PostgreSql pulls SSH.NET 2024.1.0 which has
             GHSA-q939-rpr3-3284 (transitive dep of Testcontainers, not our code).
             Tracked separately — bump Testcontainers when an upstream fix lands. -->
        <NoWarn>$(NoWarn);NU1903</NoWarn>
    </PropertyGroup>

    <!-- Native AOT tier: core runtime libraries only.
         Full-framework packages (Checkpoints.*, UI, Agents.AI, Testing) stay
         on the regular .NET runtime — do not opt them into IsAotCompatible. -->
    <PropertyGroup
        Condition="'$(MSBuildProjectName)' == 'Voluta'
                   or '$(MSBuildProjectName)' == 'Voluta.Abstractions'
                   or '$(MSBuildProjectName)' == 'Voluta.DependencyInjection'">
        <IsAotCompatible>true</IsAotCompatible>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    </PropertyGroup>

    <!-- Source-link + deterministic builds. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <!-- PublicAPI ship gate (v0.1 freeze): only when PublicAPI.Shipped.txt exists
         (baseline not committed yet — avoid RS0016 noise). Override: -p:VolutaEnablePublicApi=false -->
    <PropertyGroup
        Condition="'$(VolutaEnablePublicApi)' == ''
                   and Exists('$(MSBuildProjectDirectory)\PublicAPI.Shipped.txt')
                   and ('$(MSBuildProjectName)' == 'Voluta'
                        or '$(MSBuildProjectName)' == 'Voluta.Abstractions'
                        or '$(MSBuildProjectName)' == 'Voluta.DependencyInjection'
                        or '$(MSBuildProjectName)' == 'Voluta.OpenTelemetry'
                          or '$(MSBuildProjectName)' == 'Voluta.Checkpoints.File'
                          or '$(MSBuildProjectName)' == 'Voluta.Checkpoints.EntityFrameworkCore'
                          or '$(MSBuildProjectName)' == 'Voluta.Checkpoints.S3'
                          or '$(MSBuildProjectName)' == 'Voluta.Checkpoints.Redis'
                          or '$(MSBuildProjectName)' == 'Voluta.Agents.AI'
                          or '$(MSBuildProjectName)' == 'Voluta.UI')">
        <VolutaEnablePublicApi>true</VolutaEnablePublicApi>
    </PropertyGroup>

    <ItemGroup Condition="'$(VolutaEnablePublicApi)' == 'true'">
        <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <!-- SDK auto-includes PublicAPI.*.txt as AdditionalFiles when present — do not re-add. -->
    </ItemGroup>

    <!-- NuGet package assets (icon + readme) for all packable library projects. -->
    <ItemGroup Condition="'$(IsPackable)' != 'false'">
        <None Include="$(VolutaPackageIconPath)"
              Pack="true"
              PackagePath="$(PackageIcon)"
              Visible="false"
              Condition="Exists('$(VolutaPackageIconPath)')" />
        <None Include="$(MSBuildThisFileDirectory)README.md"
              Pack="true"
              PackagePath="README.md"
              Visible="false"
              Condition="Exists('$(MSBuildThisFileDirectory)README.md')" />
    </ItemGroup>

</Project>